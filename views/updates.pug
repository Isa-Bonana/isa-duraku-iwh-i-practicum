doctype html
html(lang="en")
    head
        title= title
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        main.container.container--narrow
            a.back-link(href="/") Return to the homepage
            h1 Add a Football Player

            //- The input names match the internal names of the custom object's properties in HubSpot.
            form(action="/update-cobj" method="POST")
                label(for="name") Name
                input(type="text" id="name" name="name" required)

                label(for="position") Position
                input(type="text" id="position" name="position")

                label(for="club") Club
                input(type="text" id="club" name="club")

                if owners && owners.length
                    label(for="hubspot_owner_id") Owner
                    select(id="hubspot_owner_id" name="hubspot_owner_id")
                        option(value="") No owner
                        each owner in owners
                            option(value=owner.id) #{owner.firstName} #{owner.lastName}

                input(type="submit" value="Add player")
